# Build environment for the AppImage.
#
# Ubuntu 24.04 is the oldest mainstream distribution with GTK 4.14 and
# libadwaita 1.5, the minimum the app needs. Building here means the
# AppImage runs on Ubuntu 24.04, Debian 13, Fedora 40, openSUSE Tumbleweed,
# Arch and anything newer.

FROM docker.io/library/ubuntu:24.04

RUN apt-get update \
 && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      build-essential pkg-config curl ca-certificates file git \
      libgtk-4-dev libadwaita-1-dev librsvg2-common libgdk-pixbuf2.0-bin libglib2.0-bin \
      dconf-gsettings-backend gsettings-desktop-schemas \
      desktop-file-utils appstream patchelf squashfs-tools \
 && rm -rf /var/lib/apt/lists/*

RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
      | sh -s -- -y --profile minimal --default-toolchain stable
ENV PATH=/root/.cargo/bin:$PATH

WORKDIR /src
